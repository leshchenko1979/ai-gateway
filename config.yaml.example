api_key: ${GATEWAY_API_KEY} # Missing env vars fail fast at startup
port: 8080
default_step_timeout: 30s
default_route_timeout: 300s

providers:
  - name: cerebras
    api_key: ${CEREBRAS_API_KEY}
    base_url: https://api.cerebras.ai/v1

  - name: openrouter
    api_key: ${OPENROUTER_API_KEY}
    base_url: https://openrouter.ai/api/v1

routes:
  - name: cerebras-first
    steps:
      - provider: cerebras
        model: gpt-oss-120b
        conflict_resolution: tools
      - provider: openrouter
        model: nvidia/nemotron-3-nano-30b-a3b:free

  - name: openrouter-only
    steps:
      - provider: openrouter
        model: nvidia/nemotron-3-nano-30b-a3b:free

  - name: n8n-heavy
    route_timeout: 5m
    steps:
      - provider: cerebras
        model: gpt-oss-120b
        step_timeout: 5m
        conflict_resolution: tools
      - provider: openrouter
        model: nvidia/nemotron-3-nano-30b-a3b:free
        step_timeout: 5m
