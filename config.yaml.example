api_key: ${GATEWAY_API_KEY} # Missing env vars fail fast at startup
port: 8080
default_step_timeout: 30s
default_route_timeout: 300s

providers:
  - name: cerebras
    api_key: ${CEREBRAS_API_KEY}
    base_url: https://api.cerebras.ai/v1
    strict_json_schema: true # cerebras/groq require additionalProperties:false in json_schema

  - name: groq
    api_key: ${GROQ_API_KEY}
    base_url: https://api.groq.com/openai/v1/
    strict_json_schema: true

  - name: openrouter
    api_key: ${OPENROUTER_API_KEY}
    base_url: https://openrouter.ai/api/v1

routes:
  - name: cerebras-first
    steps:
      - provider: cerebras
        model: gpt-oss-120b
        thinking: true # tri-state: true=thinking (relax forced tool_choice unconditionally), false=explicit opt-out (never relax, even if the model name is in the hardcoded list), unset=fall back to the hardcoded isThinkingModel list
      - provider: openrouter
        model: nvidia/nemotron-3-nano-30b-a3b:free

  - name: openrouter-only
    steps:
      - provider: openrouter
        model: nvidia/nemotron-3-nano-30b-a3b:free

  - name: n8n-heavy
    route_timeout: 5m
    step_cooldown: 5m # optional per-route rotation cooldown (default: default_step_cooldown or 60s)
    steps:
      - provider: cerebras
        model: gpt-oss-120b
        step_timeout: 5m
      - provider: openrouter
        model: nvidia/nemotron-3-nano-30b-a3b:free
        step_timeout: 5m
