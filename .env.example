# SSH Configuration for Remote Deployment
SSH_HOST=example.com
SSH_USER=root
DOMAIN=ai-gateway.example.com
SSH_KEY=~/.ssh/id_rsa
SSH_PORT=22

# Image pulled by docker compose (VDS — set in runtime .env synced to server)
GHCR_IMAGE=ghcr.io/leshchenko1979/ai-gateway
IMAGE_TAG=main

# Optional: docker login on the VDS for private GHCR (local only — excluded from synced .env)
# Use a GitHub PAT with read:packages. Username is your GitHub username.
GHCR_PULL_USER=
GHCR_PULL_TOKEN=

# OTLP telemetry (optional — both OTLP_ENDPOINT and OTLP_API_KEY must be set to enable)
# Logfire US example (duplicate write token in OTLP_HEADERS to override Basic auth):
# OTLP_ENDPOINT=https://logfire-us.pydantic.dev
# OTLP_API_KEY=your-write-token
# OTLP_HEADERS=Authorization=your-write-token
# Grafana Cloud example: OTLP_ENDPOINT=https://otlp-gateway-prod-….grafana.net/otlp/ and OTLP_API_KEY=glc_…
OTLP_ENDPOINT=
OTLP_API_KEY=
OTLP_SERVICE_NAME=ai-gateway
OTLP_RESOURCE_ATTRIBUTES=deployment.environment=production
# Extra headers (format: Key=Value,Key2=Value2). Required for Logfire; optional for Grafana.
OTLP_HEADERS=
