{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Sync config and env to VDS",
      "type": "shell",
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/sync-config-to-vds.sh"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Deploy Docker to VDS (ops.sh deploy-docker)",
      "type": "shell",
      "command": "bash",
      "args": [
        "${workspaceFolder}/ops.sh",
        "deploy-docker"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Verify provider model lists",
      "type": "shell",
      "command": "go",
      "args": [
        "run",
        "./cmd/check-models"
      ],
      "options": {
        "cwd": "${workspaceFolder}/app",
        "envFile": "${workspaceFolder}/.env"
      },
      "group": {
        "kind": "test",
        "isDefault": false
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": [
        "$go"
      ]
    },
    {
      "label": "Query deployed upstream models check",
      "type": "shell",
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/query-deployed-upstream-models.sh"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": false
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}